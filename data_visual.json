{
  "project_name": "Data Visualization Preset Showcase",
  "global_settings": { "width": 1920, "height": 1080, "fps": 30 },
  "scenes": [
    {
      "scene_id": "all-presets",
      "duration_in_frames": 3600,
      "background_type": "procedural",
      "procedural_config": { "variant": "neon_grid", "primaryColor": "#050505", "secondaryColor": "#111827" },
      "overlays": [
        {
          "id": "stat_1", "type": "data_indicator", "indicator_type": "kpiNumber", "label": "Global Population", "value": 8000000000, "suffix": "+", "start": 0, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_2", "type": "data_indicator", "indicator_type": "percentageCounter", "label": "Internet Access", "value": 67, "start": 90, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_3", "type": "data_indicator", "indicator_type": "progressBar", "label": "Project Alpha", "value": 85, "start": 180, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_4", "type": "data_indicator", "indicator_type": "circularProgress", "label": "Server Health", "value": 92, "start": 270, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_5", "type": "data_indicator", "indicator_type": "semiGauge", "label": "Risk Factor", "value": 4.5, "suffix": "/10", "start": 360, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_6", "type": "data_indicator", "indicator_type": "milestoneTracker", "milestones": [ { "label": "Phase 1" }, { "label": "Phase 2" }, { "label": "Phase 3" } ], "start": 450, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
