        },
        {
          "id": "chart_30", "type": "chart", "chart_type": "sankey", "title": "Cash Flow", "data": { "nodes": [{ "id": "A" }, { "id": "B" }], "links": [{ "source": "A", "target": "B", "value": 10 }] }, "start": 2610, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_31", "type": "chart", "chart_type": "chord", "title": "Relationships", "keys": ["A", "B"], "data": [ [0, 10], [10, 0] ], "start": 2700, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_32", "type": "chart", "chart_type": "network", "title": "Social Graph", "data": { "nodes": [{ "id": "A", "color": "red" }, { "id": "B", "color": "blue" }, { "id": "C", "color": "green" }], "links": [{ "source": "A", "target": "B", "distance": 100 }, { "source": "B", "target": "C", "distance": 100 }] }, "start": 2790, "duration": 90, "position": { "x": 960, "y": 540 }
