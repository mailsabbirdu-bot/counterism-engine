        },
        {
          "id": "stat_8", "type": "data_indicator", "indicator_type": "deltaIndicator", "label": "Stock Price", "value": 12.5, "start": 630, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_9", "type": "data_indicator", "indicator_type": "countdown", "seconds": 3, "start": 720, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "stat_10", "type": "data_indicator", "indicator_type": "dashboardCard", "label": "Active Users", "value": 15420, "prefix": "", "trend": "+18%", "start": 810, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_11", "type": "chart", "chart_type": "horizontalBar", "title": "GDP Comparison", "indexBy": "country", "keys": ["gdp"], "data": [ { "country": "USA", "gdp": 25 }, { "country": "China", "gdp": 18 }, { "country": "Japan", "gdp": 5 } ], "start": 900, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_12", "type": "chart", "chart_type": "verticalBar", "title": "Quarterly Sales", "indexBy": "q", "keys": ["sales"], "data": [ { "q": "Q1", "sales": 100 }, { "q": "Q2", "sales": 150 } ], "start": 990, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_13", "type": "chart", "chart_type": "groupedBar", "title": "Gender Distribution", "indexBy": "year", "keys": ["male", "female"], "data": [ { "year": "2020", "male": 45, "female": 55 } ], "start": 1080, "duration": 90, "position": { "x": 960, "y": 540 }
