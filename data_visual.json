        },
        {
          "id": "chart_19", "type": "chart", "chart_type": "stackedArea", "title": "Cloud Usage", "data": [ { "id": "A", "data": [{ "x": 0, "y": 50 }] } ], "start": 1620, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_20", "type": "chart", "chart_type": "forecast", "title": "Sales Projection", "data": [ { "id": "f", "data": [{ "x": 0, "y": 50 }] } ], "start": 1710, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_21", "type": "chart", "chart_type": "pie", "title": "Market Share", "data": [ { "id": "A", "value": 50 }, { "id": "B", "value": 50 } ], "start": 1800, "duration": 90, "position": { "x": 960, "y": 540 }
