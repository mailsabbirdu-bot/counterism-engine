        },
        {
          "id": "chart_26", "type": "chart", "chart_type": "boxPlot", "title": "Salary Spread", "data": [ { "group": "A", "mu": 50, "sd": 10 } ], "start": 2250, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_27", "type": "chart", "chart_type": "violinPlot", "title": "Data Density", "data": [ { "label": "Group A", "value": 100 } ], "start": 2340, "duration": 90, "position": { "x": 960, "y": 540 }
        },
        {
          "id": "chart_28", "type": "chart", "chart_type": "scatter", "title": "Price vs Quality", "data": [ { "id": "A", "data": [{ "x": 10, "y": 20 }] } ], "start": 2430, "duration": 90, "position": { "x": 960, "y": 540 }
