{
  "project_name": "Studio V4 - Ultra Modern Nivo Showcase",
  "global_settings": { "width": 1920, "height": 1080, "fps": 30 },
  "scenes": [
    {
      "scene_id": "SCENE_01_CHARTS_SHOWCASE",
      "duration_in_frames": 900,
      "background_type": "video",
      "video_path": "renders/scene_SC_01.mp4",
      "overlays": [
        { "id": "t1", "type": "text", "content": "ULTRA MODERN CHARTS", "font": "Orbitron", "position": { "x": 960, "y": 100 }, "start": 0, "duration": 900 },
        { "id": "c1", "type": "chart", "chart_type": "bump", "title": "Bump Chart", "start": 30, "duration": 200, "position": { "x": 480, "y": 350 }, "width": 800, "height": 400, "data": [{"id": "A", "data": [{"x": 1, "y": 1}, {"x": 2, "y": 2}]}, {"id": "B", "data": [{"x": 1, "y": 2}, {"x": 2, "y": 1}]}] },
        { "id": "c2", "type": "chart", "chart_type": "radar", "title": "Radar Chart", "start": 60, "duration": 200, "position": { "x": 1440, "y": 350 }, "width": 800, "height": 400, "keys": ["v1", "v2"], "indexBy": "id", "data": [{"id": "X", "v1": 80, "v2": 40}, {"id": "Y", "v1": 50, "v2": 90}] },
        { "id": "c3", "type": "chart", "chart_type": "heatmap", "title": "HeatMap", "start": 250, "duration": 200, "position": { "x": 480, "y": 700 }, "width": 800, "height": 400, "data": [{"id": "R1", "data": [{"x": "C1", "value": 50}, {"x": "C2", "value": 100}]}, {"id": "R2", "data": [{"x": "C1", "value": 80}, {"x": "C2", "value": 30}]}] },
        { "id": "c4", "type": "chart", "chart_type": "radialBar", "title": "Radial Bar", "start": 280, "duration": 200, "position": { "x": 1440, "y": 700 }, "width": 800, "height": 400, "data": [{"id": "A", "data": [{"x": "X", "y": 10}, {"x": "Y", "y": 20}]}] },
        { "id": "c5", "type": "chart", "chart_type": "waffle", "title": "Waffle Chart", "start": 470, "duration": 200, "position": { "x": 480, "y": 540 }, "width": 600, "height": 400, "total": 100, "data": [{"id": "A", "value": 35}, {"id": "B", "value": 65}] },
        { "id": "c6", "type": "chart", "chart_type": "funnel", "title": "Funnel Chart", "start": 500, "duration": 200, "position": { "x": 1440, "y": 540 }, "width": 600, "height": 400, "data": [{"id": "S1", "value": 100, "label": "Step 1"}, {"id": "S2", "value": 60, "label": "Step 2"}] },
        { "id": "c7", "type": "chart", "chart_type": "marimekko", "title": "Marimekko", "start": 700, "duration": 200, "position": { "x": 960, "y": 540 }, "width": 1000, "height": 600, "dimensions": [{"id": "X", "value": "v1"}, {"id": "Y", "value": "v2"}], "data": [{"id": "A", "v1": 40, "v2": 60}, {"id": "B", "v1": 70, "v2": 30}] }
      ],
      "camera": { "enabled": true, "shots": [{ "targetId": "c1", "startFrame": 30, "duration": 200 }, { "targetId": "c3", "startFrame": 250, "duration": 200 }, { "targetId": "c7", "startFrame": 700, "duration": 200 }] }
    },
    {
      "scene_id": "SCENE_02_INDICATORS_SHOWCASE",
      "duration_in_frames": 900,
      "background_type": "video",
      "video_path": "renders/scene_SC_02.mp4",
      "overlays": [
        { "id": "t2", "type": "text", "content": "SMART INDICATORS", "font": "Orbitron", "position": { "x": 960, "y": 100 }, "start": 0, "duration": 900 },
        { "id": "i1", "type": "data_indicator", "indicator_type": "speedometer", "label": "Velocity", "value": 180, "max": 220, "start": 30, "duration": 200, "position": { "x": 480, "y": 350 } },
        { "id": "i2", "type": "data_indicator", "indicator_type": "techMetric", "label": "Neural Load", "value": 94, "start": 60, "duration": 200, "position": { "x": 1440, "y": 350 } },
        { "id": "i3", "type": "data_indicator", "indicator_type": "statGrid", "start": 250, "duration": 200, "position": { "x": 480, "y": 700 }, "stats": [{"label": "CPU", "value": 45, "suffix": "%"}, {"label": "RAM", "value": 12, "suffix": "GB"}] },
        { "id": "i4", "type": "data_indicator", "indicator_type": "dataWave", "label": "Signal", "value": 85, "suffix": "dB", "start": 280, "duration": 200, "position": { "x": 1440, "y": 700 } },
        { "id": "i5", "type": "data_indicator", "indicator_type": "scoreCard", "label": "Rating", "value": 9.8, "start": 470, "duration": 200, "position": { "x": 480, "y": 540 } },
        { "id": "i6", "type": "data_indicator", "indicator_type": "batteryLevel", "label": "Charge", "value": 72, "start": 500, "duration": 200, "position": { "x": 1440, "y": 540 } },
        { "id": "i7", "type": "data_indicator", "indicator_type": "multiProgress", "start": 700, "duration": 200, "position": { "x": 960, "y": 540 }, "items": [{"label": "Core A", "value": 90}, {"label": "Core B", "value": 40}] }
      ],
      "camera": { "enabled": true, "shots": [{ "targetId": "i1", "startFrame": 30, "duration": 200 }, { "targetId": "i3", "startFrame": 250, "duration": 200 }, { "targetId": "i7", "startFrame": 700, "duration": 200 }] }
    }
  ]
}
