{
  "project_name": "Ultimate Camera Sync Stress Test",
  "global_settings": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "scenes": [
    {
      "scene_id": "SYNC-TEST",
      "background_type": "video",
      "video_path": "renders/scene_SC_01.mp4",
      "audio_enabled": false,
      "duration_in_frames": 300,
      "camera": {
        "enabled": true,
        "perspective": 500,
        "pathSmoothing": true,
        "motionBlur": { "enabled": true, "intensity": 1.5 },
        "shake": { "enabled": true, "intensity": 6, "speed": 2.0, "rotationIntensity": 1.2 },
        "keyframes": [
          {
            "frame": 0,
            "x": 0, "y": 0, "z": 2000, "zoom": 1,
            "lookAt": { "x": 0, "y": 0, "z": 0 },
            "easing": "ease"
          },
          {
            "frame": 150,
            "x": -2000, "y": -1200, "z": 0, "zoom": 4,
            "lookAt": { "x": -1000, "y": -600, "z": 0 },
            "easing": { "type": "bezier", "bezier": [0.85, 0, 0.15, 1] }
          },
          {
            "frame": 299,
            "x": 2000, "y": 1200, "z": 500, "zoom": 4,
            "lookAt": { "x": 1000, "y": 600, "z": 0 },
            "easing": "ease"
          }
        ]
      },
      "overlays": [
        {
          "id": "CENTER-TAG",
          "type": "text",
          "content": "STAY CENTERED",
          "font": "Montserrat",
          "fontSize": "100px",
          "style": "text-white font-black",
          "position": { "x": 960, "y": 540 },
          "start": 0, "duration": 300, "depth": 0
        },
        {
          "id": "BG-ANCHOR-1",
          "type": "shape",
          "shape_type": "rect",
          "size": 50, "color": "#ff0000",
          "position": { "x": 100, "y": 100 },
          "start": 0, "duration": 300, "depth": 0
        },
        {
          "id": "BG-ANCHOR-2",
          "type": "shape",
          "shape_type": "rect",
          "size": 50, "color": "#00ff00",
          "position": { "x": 1820, "y": 980 },
          "start": 0, "duration": 300, "depth": 0
        }
      ]
    }
  ]
}
