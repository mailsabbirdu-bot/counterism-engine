{
  "project_name": "Counterism_Studio_V4_Pro_Cinematic",
  "global_settings": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "scenes": [
    {
      "scene_id": "SC-01-INTRO",
      "background_type": "video",
      "video_path": "renders/scene_SC_01.mp4",
      "audio_enabled": true,
      "duration_in_frames": 150,
      "camera": {
        "enabled": true,
        "preset": "slowPushIn"
      },
      "overlays": [
        {
          "id": "title-main",
          "type": "text",
          "content": "COUNTERISM V4",
          "start": 0,
          "duration": 150,
          "font": "Montserrat",
          "fontSize": "180px",
          "style": "text-white font-black tracking-tighter",
          "zIndex": 100,
          "depth": 1.2
        },
        {
          "id": "sub-title",
          "type": "text",
          "content": "THE FUTURE OF CINEMATIC AUTOMATION",
          "start": 30,
          "duration": 120,
          "font": "Montserrat",
          "fontSize": "40px",
          "position": { "x": 0, "y": 200 },
          "style": "text-blue-400 font-bold tracking-[0.5em]",
          "zIndex": 90,
          "depth": 0.8
        }
      ]
    },
    {
      "scene_id": "SC-02-DYNAMICS",
      "background_type": "video",
      "video_path": "renders/scene_SC_02.mp4",
      "audio_enabled": true,
      "duration_in_frames": 300,
      "camera": {
        "enabled": true,
        "preset": "panRight",
        "keyframes": [
          { "frame": 0, "x": 400, "y": 0, "zoom": 1 },
          { "frame": 150, "x": 0, "y": 0, "zoom": 1.1 },
          { "frame": 300, "x": -400, "y": 0, "zoom": 1.05 }
        ]
      },
      "overlays": [
        {
          "id": "pip-video",
          "type": "video",
          "src": "renders/scene_SC_01.mp4",
          "start": 0,
          "duration": 300,
          "position": { "x": 1000, "y": 200 },
          "width": 800,
          "height": 450,
          "borderRadius": 40,
          "shadow": true,
          "border": { "width": 10, "color": "#3b82f6" },
          "zIndex": 20,
          "depth": 1.5,
          "audio_enabled": false
        },
        {
          "id": "stats-panel",
          "type": "ui_panel",
          "title": "ENGINE STATUS",
          "description": "Dynamic camera and parallax depth active.",
          "iconType": "activity",
          "start": 60,
          "duration": 240,
          "position": { "x": 100, "y": 100 },
          "variant": "glass",
          "initialProgress": 0,
          "targetProgress": 100,
          "zIndex": 40,
          "depth": 0.5
        }
      ]
    },
    {
      "scene_id": "SC-03-FLOAT",
      "background_type": "video",
      "video_path": "renders/scene_SC_03.mp4",
      "audio_enabled": true,
      "duration_in_frames": 240,
      "camera": {
        "enabled": true,
        "preset": "cinematicFloat"
      },
      "overlays": [
        {
          "id": "data-viz",
          "type": "chart",
          "chart_type": "line",
          "title": "NETWORK STABILITY",
          "start": 0,
          "duration": 240,
          "width": 1200,
          "height": 700,
          "position": { "x": 360, "y": 190 },
          "zIndex": 30,
          "depth": 1.0,
          "data": [
            {
              "id": "latency",
              "data": [
                { "x": "0ms", "y": 10 },
                { "x": "10ms", "y": 40 },
                { "x": "20ms", "y": 25 },
                { "x": "30ms", "y": 80 }
              ]
            }
          ]
        }
      ]
    }
  ]
}
